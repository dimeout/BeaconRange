{
	"schemaVersion": 1,
	"id": "beaconrange",
	"version": "${version}",
	"name": "Beacon Range",
	"description": "Client-side beacon coverage visualization for Minecraft. See each beacon's effective range, customize its color, and toggle visualizations from a configurable keybind.",
	"authors": [
		"Dimeout"
	],
	"contact": {
		"homepage": "https://github.com/dimeout/BeaconRange",
		"sources": "https://github.com/dimeout/BeaconRange"
	},
	"license": "CC0-1.0",
	"icon": "assets/beaconrange/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.ExampleMod"
		],
		"client": [
			"com.example.client.ExampleModClient"
		]
	},
	"mixins": [
		"beaconrange.mixins.json",
		{
			"config": "beaconrange.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}